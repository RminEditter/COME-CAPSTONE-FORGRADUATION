// Emulator security contract. Merge these protections into live rules before enabling rewards.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  match /users/{uid} {
   allow read: if owner(uid);
   allow create: if owner(uid) && !request.resource.data.keys().hasAny(['pointBalance']);
   allow update: if owner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pointBalance']);
   allow delete: if false;
   match /point_history/{id} { allow read: if owner(uid); allow write: if false; }
   match /point_awards/{id} { allow read: if owner(uid); allow write: if false; }
  }
  match /point_config/{id} { allow read, write: if false; }
  match /cafes/{id} { allow read: if signedIn(); allow write: if false; }
  match /visit_records/{id} {
   allow read: if signedIn();
   allow create: if signedIn() && request.resource.data.userUid == request.auth.uid
     && request.resource.data.cafeId is string
     && exists(/databases/$(database)/documents/cafes/$(request.resource.data.cafeId));
   allow update: if signedIn() && resource.data.userUid == request.auth.uid
     && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userUid','cafeId','visitedAt']);
   allow delete: if signedIn() && resource.data.userUid == request.auth.uid;
  }
 }
}
