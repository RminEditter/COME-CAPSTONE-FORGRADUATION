        <item name="colorControlNormal">@color/text_muted</item>
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:windowBackground">@color/ivory_bg</item>
        <item name="android:statusBarColor">@color/ivory_bg</item>
        <item name="android:navigationBarColor">@color/ivory_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.Capstone2026" parent="Base.Theme.Capstone2026" />
</resources>
