<resources>
    <!-- Existing screens use the light coffee palette in both device modes. -->
    <style name="Base.Theme.Capstone2026" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brown_main</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/beige_soft</item>
        <item name="colorOnPrimaryContainer">@color/brown_dark</item>
        <item name="colorSecondary">@color/brown_main</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/beige_soft</item>
        <item name="colorOnSecondaryContainer">@color/brown_dark</item>
        <item name="colorTertiary">@color/brown_dark</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/surface_variant</item>
        <item name="colorOnTertiaryContainer">@color/text_dark</item>
        <item name="android:colorBackground">@color/ivory_bg</item>
        <item name="colorOnBackground">@color/text_dark</item>
        <item name="colorSurface">@color/surface_warm</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
