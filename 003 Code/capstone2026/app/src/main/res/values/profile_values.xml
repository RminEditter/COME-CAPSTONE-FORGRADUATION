    <string name="profile_nickname_invalid">닉네임을 1~20자로 입력해주세요.</string>
    <string name="profile_edit_description">카페에서 사용할 나의 이름을 정해보세요.</string>
    <string-array name="profile_gender_options"><item>선택 안 함</item><item>여성</item><item>남성</item></string-array>
    <string-array name="profile_age_options"><item>선택 안 함</item><item>10대</item><item>20대</item><item>30대</item><item>40대 이상</item></string-array>
    <style name="ProfileCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_home_card</item>
        <item name="android:padding">20dp</item>
    </style>
    <style name="ProfileSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brown_dark</item>
        <item name="android:tag">profile_heading</item>
    </style>
    <style name="ProfileDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/profile_muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="ProfileAction" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/rounded_beige_button</item>
        <item name="backgroundTint">@color/beige_soft</item>
        <item name="android:textColor">@color/brown_dark</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="ProfileStat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">88dp</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="ProfileStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brown_main</item>
        <item name="android:text">@string/profile_unknown</item>
    </style>
</resources>
