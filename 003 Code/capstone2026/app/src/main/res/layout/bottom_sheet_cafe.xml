<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomSheetLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_warm"
    android:elevation="16dp"
    android:orientation="vertical"
    android:padding="20dp"
    app:behavior_hideable="true"
    app:behavior_peekHeight="0dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <View android:layout_width="42dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp"
        android:background="@color/outline_warm" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="선택한 카페" android:textColor="@color/brown_main"
        android:textSize="12sp" android:textStyle="bold" />

    <TextView android:id="@+id/tvCafeName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="카페 이름" android:textColor="@color/text_dark"
        android:textSize="22sp" android:textStyle="bold"
        android:maxLines="2" android:ellipsize="end" />

    <TextView android:id="@+id/tvCafeAddress" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="카페 주소" android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupCafeTags" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="vertical"
        android:padding="12dp" android:background="#F4E9DE">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="이 카페를 추천하는 이유" android:textColor="@color/brown_main"
            android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvCafeReason" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="카페 특징을 확인해 보세요" android:textColor="@color/text_dark"
            android:textSize="14sp" android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <Button android:id="@+id/btnOpenDetail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:backgroundTint="@color/brown_main" android:text="카페 상세 정보 보기"
        android:textColor="@android:color/white" android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
