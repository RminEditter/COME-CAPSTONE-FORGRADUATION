<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:id="@+id/profileRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/ivory_bg" tools:context=".ProfileEditActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnBack"
            style="@style/ProfileAction" android:layout_width="wrap_content" android:text="@string/profile_back"/>
        <TextView style="@style/ProfileSectionTitle" android:layout_marginTop="24dp"
            android:text="@string/profile_edit" android:textSize="28sp"/>
        <TextView style="@style/ProfileDescription" android:text="@string/profile_edit_description"/>
        <TextView android:id="@+id/txtProfileStatus" style="@style/ProfileDescription"
            android:accessibilityLiveRegion="polite" android:text="@string/profile_loading"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnRetryProfile"
            style="@style/ProfileAction" android:text="@string/profile_retry" android:visibility="gone"/>
        <LinearLayout style="@style/ProfileCard">
            <TextView style="@style/ProfileSectionTitle" android:text="@string/profile_nickname"
                android:labelFor="@id/editProfileNickname"/>
            <EditText android:id="@+id/editProfileNickname" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp"
                android:background="@drawable/bg_search_box" android:padding="16dp"
                android:textColor="@color/text_dark" android:textColorHint="@color/profile_muted"
                android:hint="@string/profile_nickname_hint" android:inputType="textPersonName"
                android:autofillHints="nickname" android:maxLines="1"/>
            <TextView style="@style/ProfileSectionTitle" android:layout_marginTop="24dp"
                android:text="@string/profile_gender" android:labelFor="@id/spinnerProfileGender"/>
            <Spinner android:id="@+id/spinnerProfileGender" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp"
                android:background="@drawable/bg_search_box" android:paddingStart="12dp" android:paddingEnd="12dp"/>
            <TextView style="@style/ProfileSectionTitle" android:layout_marginTop="24dp"
                android:text="@string/profile_age" android:labelFor="@id/spinnerProfileAge"/>
            <Spinner android:id="@+id/spinnerProfileAge" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp"
                android:background="@drawable/bg_search_box" android:paddingStart="12dp" android:paddingEnd="12dp"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSaveProfile"
                style="@style/ProfileAction" android:layout_marginTop="24dp"
                android:background="@drawable/rounded_brown_button" android:textColor="@color/white"
                app:backgroundTint="@color/brown_main"
                android:text="@string/profile_save" android:enabled="false"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
