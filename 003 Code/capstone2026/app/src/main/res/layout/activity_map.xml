<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory_bg">

    <!-- 메인 컨텐츠 (상단 바, 스피너, 태그 필터, 지도) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. 상단 타이틀 바 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBack"
                android:layout_width="72dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_back_button"
                android:text="←"
                android:textAllCaps="false"
                android:textColor="@color/brown_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="🗺 카페 지도"
                android:textColor="@color/brown_dark"
                android:textSize="23sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 2. 자치구 스피너 & 내 위치 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp">

            <Spinner
                android:id="@+id/spinnerDistrict"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_box"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btnMyLocation"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/brown_dark"
                android:singleLine="true"
                android:text="내 위치"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 상세 필터: 버튼 하나로 상단 공간 확보 -->
        <Button
            android:id="@+id/btnTagFilter"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="6dp"
            android:text="상세 필터"
            android:textAllCaps="false"
            android:textColor="#503A30"
            android:backgroundTint="#F2E4D7" />

        <TextView
            android:id="@+id/mapMarkerLegend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="#424242"
            android:background="#FFFFFF"
            android:textSize="12sp"
            android:accessibilityLiveRegion="polite" />

        <!-- 4. 지도 영역 (LinearLayout 내부에서 남아있는 공간을 채우도록 layout_height="match_parent" 설정) -->
        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:ignore="MissingClass" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp">
        <TextView
            android:id="@+id/btnMapZoomIn"
            android:layout_width="50dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="+"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#503A30"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="지도 확대" />
        <TextView
            android:id="@+id/btnMapZoomOut"
            android:layout_width="50dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="−"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#503A30"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="지도 축소" />
    </LinearLayout>

    <!-- 5. 마커 클릭 시 올라올 하단 바텀시트 레이아웃 연결 -->
    <include layout="@layout/bottom_sheet_cafe" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>