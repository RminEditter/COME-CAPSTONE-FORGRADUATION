<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profileRoot" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/ivory_bg" tools:context=".ProfileActivity">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView style="@style/ProfileDescription" android:text="@string/profile_intro"/>
            <TextView style="@style/ProfileSectionTitle" android:layout_marginTop="4dp"
                android:text="@string/profile_title" android:textSize="28sp"/>
            <LinearLayout style="@style/ProfileCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="64dp" android:layout_height="64dp"
                        android:background="@drawable/bg_profile_avatar" android:padding="16dp"
                        android:src="@drawable/ic_profile_cup" android:importantForAccessibility="no"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
                        <TextView android:id="@+id/txtProfileName" style="@style/ProfileSectionTitle"
                            android:text="@string/profile_default_name" android:textSize="22sp"
                            android:maxLines="2" android:ellipsize="end" tools:text="카페 탐험가"/>
                        <TextView style="@style/ProfileDescription" android:text="@string/profile_identity"/>
                    </LinearLayout>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnEditProfile"
                    style="@style/ProfileAction" android:text="@string/profile_edit"/>
            </LinearLayout>
            <TextView android:id="@+id/txtProfileStatus" style="@style/ProfileDescription"
                android:accessibilityLiveRegion="polite" android:text="@string/profile_loading"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnRetryProfile"
                style="@style/ProfileAction" android:text="@string/profile_retry" android:visibility="gone"/>
            <LinearLayout style="@style/ProfileCard">
                <TextView style="@style/ProfileSectionTitle" android:text="@string/profile_activity"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp" android:baselineAligned="false">
                    <LinearLayout android:id="@+id/statVisits" style="@style/ProfileStat">
                        <TextView android:id="@+id/txtVisitCount" style="@style/ProfileStatValue" tools:text="12"/>
                        <TextView style="@style/ProfileDescription" android:gravity="center" android:text="@string/profile_visits"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/statFavorites" style="@style/ProfileStat">
                        <TextView android:id="@+id/txtFavoriteCount" style="@style/ProfileStatValue" tools:text="5"/>
                        <TextView style="@style/ProfileDescription" android:gravity="center" android:text="@string/profile_favorites"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/statBadges" style="@style/ProfileStat">
                        <TextView android:id="@+id/txtBadgeCount" style="@style/ProfileStatValue" tools:text="3"/>
                        <TextView style="@style/ProfileDescription" android:gravity="center" android:text="@string/profile_badges"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout style="@style/ProfileCard">
                <TextView style="@style/ProfileSectionTitle" android:text="@string/profile_taste"/>
                <TextView style="@style/ProfileDescription" android:text="@string/profile_taste_description"/>
                <com.google.android.material.chip.ChipGroup android:id="@+id/chipProfileTaste"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" app:chipSpacingHorizontal="6dp" app:singleLine="false"/>
                <TextView android:id="@+id/txtTasteEmpty" style="@style/ProfileDescription"
                    android:text="@string/profile_no_survey" android:visibility="gone"/>
                <TextView android:id="@+id/txtProfilePriority" style="@style/ProfileDescription"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnProfileSurvey"
                    style="@style/ProfileAction" android:background="@drawable/rounded_brown_button"
                    app:backgroundTint="@color/brown_main"
                    android:textColor="@color/white" android:text="@string/profile_survey"/>
            </LinearLayout>
            <LinearLayout style="@style/ProfileCard">
                <TextView style="@style/ProfileSectionTitle" android:text="@string/profile_records"/>
                <TextView style="@style/ProfileDescription" android:text="@string/profile_history_hint"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnProfileHistory"
                    style="@style/ProfileAction" android:text="@string/profile_history_link"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnProfileFavorites"
                    style="@style/ProfileAction" android:text="@string/profile_favorites_link"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnViewBadges"
                    style="@style/ProfileAction" android:text="@string/profile_badges_link"/>
            </LinearLayout>
            <LinearLayout style="@style/ProfileCard">
                <TextView style="@style/ProfileSectionTitle" android:text="@string/profile_settings"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnLogout"
                    style="@style/ProfileAction" android:text="@string/profile_logout"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/profile_bottom_nav"/>
</LinearLayout>
