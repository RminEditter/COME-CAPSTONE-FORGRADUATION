<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/ivory_bg" android:focusableInTouchMode="true">
    <ScrollView android:id="@+id/homeScroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/txtHomeTitle" style="@style/HomeHeading"
                    android:layout_width="0dp" android:layout_weight="1" android:text="CAFE FIT" android:textSize="22sp" android:letterSpacing="0.12" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHomeMenu" style="@style/HomeAction"
                    android:layout_width="48dp" android:text="☰" android:textSize="24sp" android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/home_menu" />
            </LinearLayout>
            <TextView android:id="@+id/txtHomeSub" style="@style/HomeHeading" android:layout_marginTop="16dp"
                android:text="@string/home_greeting" android:textSize="26sp" />
            <androidx.appcompat.widget.AppCompatEditText android:id="@+id/editSearch" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:layout_marginTop="20dp" android:padding="16dp" android:background="@drawable/bg_search_box"
                android:hint="@string/home_search" android:inputType="text" android:singleLine="true" android:imeOptions="actionSearch"
                android:textSize="14sp" android:textColor="@color/text_dark" android:textColorHint="@color/home_muted"
                app:drawableStartCompat="@drawable/ic_home_search" android:drawablePadding="12dp" />
            <TextView style="@style/HomeHeading" android:layout_marginTop="24dp" android:text="@string/home_taste" />
            <com.google.android.material.chip.ChipGroup android:id="@+id/homeSituations" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" app:chipSpacingHorizontal="8dp" app:singleSelection="true">
                <com.google.android.material.chip.Chip android:id="@+id/chipHomeStudy" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/home_study" android:textColor="@color/brown_dark" android:checkable="true"
                    app:chipIcon="@drawable/ic_home_book" app:chipBackgroundColor="@color/beige_soft" app:ensureMinTouchTargetSize="true" />
                <com.google.android.material.chip.Chip android:id="@+id/chipHomeDate" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/home_date" android:textColor="@color/brown_dark" android:checkable="true"
                    app:chipIcon="@drawable/ic_home_heart" app:chipBackgroundColor="@color/beige_soft" app:ensureMinTouchTargetSize="true" />
                <com.google.android.material.chip.Chip android:id="@+id/chipHomeSolo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/home_solo" android:textColor="@color/brown_dark" android:checkable="true"
                    app:chipIcon="@drawable/ic_profile_cup" app:chipBackgroundColor="@color/beige_soft" app:ensureMinTouchTargetSize="true" />
            </com.google.android.material.chip.ChipGroup>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical">
                <TextView style="@style/HomeHeading" android:layout_width="0dp" android:layout_weight="1" android:text="@string/home_for_you" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHomeSurvey" style="@style/HomeAction"
                    android:text="@string/home_edit_taste" android:background="?attr/selectableItemBackground" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cardRecommend" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_home_feature">
                <FrameLayout android:layout_width="match_parent" android:layout_height="180dp" android:background="@drawable/bg_home_photo">
                    <ImageView android:id="@+id/imgHomeCafe" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:src="@drawable/ic_profile_cup" android:scaleType="center" android:contentDescription="카페 대표 사진" />
                    <TextView android:id="@+id/txtHomePhotoState" style="@style/HomeBody" android:layout_gravity="bottom"
                        android:gravity="center" android:padding="12dp" android:text="@string/home_photo_empty" />
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnHomeFavorite" android:layout_width="48dp"
                        android:layout_height="48dp" android:layout_gravity="top|end" android:layout_margin="12dp"
                        android:background="@drawable/bg_back_button" android:src="@drawable/ic_home_bookmark" android:padding="12dp"
                        android:contentDescription="@string/home_bookmark" android:enabled="false" />
                </FrameLayout>
                <LinearLayout android:id="@+id/homePhotoCredits" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:id="@+id/txtHomeBadge" style="@style/HomeBody" android:text="@string/home_recommend_label" android:textSize="12sp" />
                    <TextView android:id="@+id/txtRecommendCafeName" style="@style/HomeHeading" android:layout_marginTop="8dp"
                        android:text="@string/home_loading" android:textSize="24sp" />
                    <TextView android:id="@+id/txtHomeAddress" style="@style/HomeBody" android:layout_marginTop="8dp" android:visibility="gone" />
                    <TextView android:id="@+id/txtRecommendCafeDesc" style="@style/HomeBody" android:layout_marginTop="8dp"
                        android:text="저장된 취향과 가까운 위치를 함께 살펴볼게요." />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/homeCafeTags" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp" app:chipSpacingHorizontal="6dp" />
                    <LinearLayout android:id="@+id/homeActions" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="8dp" android:gravity="center_vertical">
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnRecommendCafe" style="@style/HomeAction"
                        android:layout_width="0dp" android:layout_weight="1.4" android:text="@string/home_detail"
                        android:background="@drawable/rounded_brown_button" android:textColor="@color/white" android:enabled="false" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHomeMap" style="@style/HomeAction"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/home_map" android:enabled="false" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHomeAll" style="@style/HomeAction"
                android:layout_width="match_parent" android:text="@string/home_all" android:background="?attr/selectableItemBackground" />
            <TextView style="@style/HomeHeading" android:layout_marginTop="12dp" android:text="@string/home_recent" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_card" android:padding="16dp" android:gravity="center_vertical">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_profile_cup" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:id="@+id/txtRecentCafe" style="@style/HomeHeading" android:layout_width="match_parent" android:minHeight="48dp"
                        android:gravity="center_vertical" android:text="@string/home_recent_empty" android:textSize="16sp" android:background="?attr/selectableItemBackground" />
                    <TextView android:id="@+id/txtHomeRecentHint" style="@style/HomeBody" android:text="@string/home_recent_hint" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <TextView style="@style/HomeHeading" android:layout_marginTop="24dp" android:text="@string/home_top" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_card" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/txtTopCafe1" style="@style/HomeBody" android:minHeight="56dp" android:gravity="center_vertical"
                    android:padding="8dp" android:background="?attr/selectableItemBackground" android:text="평점을 불러오는 중…" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/beige_soft" />
                <TextView android:id="@+id/txtTopCafe2" style="@style/HomeBody" android:minHeight="56dp" android:gravity="center_vertical"
                    android:padding="8dp" android:background="?attr/selectableItemBackground" android:text="평점을 불러오는 중…" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/beige_soft" />
                <TextView android:id="@+id/txtTopCafe3" style="@style/HomeBody" android:minHeight="56dp" android:gravity="center_vertical"
                    android:padding="8dp" android:background="?attr/selectableItemBackground" android:text="평점을 불러오는 중…" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/home_bottom_nav" />
</LinearLayout>
