<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 뒤로가기 버튼 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBack"
        android:layout_width="72dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_back_button"
        android:text="←"
        android:textAllCaps="false"
        android:textColor="#4A2C1A"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- 타이틀 -->
    <TextView
        android:id="@+id/textRecommendTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:text="☕ 맞춤 추천 카페 목록"
        android:textColor="@color/brown_dark"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- 💡 정렬 칩 그룹 (추천순 / 거리순 / 평점순) -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupSort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSortRecommend"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="추천순" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSortDistance"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="거리순" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSortRating"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="평점순" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSortReviews"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="리뷰 많은 순" />

    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/textRecommendationStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingBottom="8dp"
        android:textColor="@color/brown_dark"
        android:textSize="14sp" />

    <!-- 카페 추천 리스트 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCafes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="20dp" />

</LinearLayout>
